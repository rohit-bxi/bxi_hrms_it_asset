<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_applicant_form_inherit_proposal" model="ir.ui.view">
        <field name="name">hr.applicant.form.proposal.clean</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <!-- ===================== -->
                <!-- INTERVIEW FEEDBACK -->
                <!-- ===================== -->
                <page string="Interview Feedback" invisible="stage_level &lt; 1">
                    <group>
                        <field name="stage_level" invisible="1"/>

                        <group string="Remarks">
                            <field name="first_interview_remark"
                                   placeholder="First interview feedback..."
                                   invisible="stage_level &lt; 1"/>

                            <field name="second_interview_remark"
                                   placeholder="Second interview feedback..."
                                   invisible="stage_level &lt; 2"/>

                            <field name="final_interview_remark"
                                   placeholder="Final interview feedback..."
                                   invisible="stage_level &lt; 3"/>
                        </group>
                    </group>
                </page>

                <!-- ===================== -->
                <!-- PROPOSAL / OFFER -->
                <!-- ===================== -->
                <page string="Proposal" invisible="stage_level &lt; 4">

                    <!-- OFFER LETTER ACTIONS -->
                    <group string="Offer Letter Actions" class="oe_button_box">

                        <field name="offer_letter_attachment_id" invisible="1"/>

                        <button name="action_send_application_form"
                                type="object"
                                string="Send Application Form"
                                class="btn-primary"/>

                        <button name="action_generate_offer_letter"
                                type="object"
                                string="Generate Offer Letter"
                                class="btn-primary"
                                invisible="offer_letter_attachment_id"/>

                        <button name="action_view_offer_letter"
                                type="object"
                                string="View Offer Letter"
                                class="btn-secondary"
                                invisible="not offer_letter_attachment_id"/>
                    </group>

                    <!-- ===================== -->
                    <!-- PERSONAL DETAILS -->
                    <!-- ===================== -->
                    <group string="Personal Information">
                        <group>
                            <field name="partner_name"/>
                            <field name="contact_number"/>
                            <field name="email_from"/>
                        </group>

                        <group>
                            <field name="father_name"/>
                            <field name="mother_name"/>
                            <field name="aadhar_number"/>
                            <field name="pan_number"/>
                        </group>
                    </group>

                    <!-- ADDRESS -->
                    <group string="Address and Joining">
                        <field name="full_address"/>
                        <field name="joining_date"/>
                    </group>

                    <!-- ===================== -->
                    <!-- DOCUMENTS -->
                    <!-- ===================== -->
                    <group string="Educational Documents">
                        <field name="doc_10th_id" widget="many2many_binary"/>
                        <field name="doc_12th_id" widget="many2many_binary"/>
                        <field name="doc_graduation_id" widget="many2many_binary"/>
                        <field name="doc_master_id" widget="many2many_binary"/>
                    </group>

                    <group string="Other Documents">
                        <field name="form_16_id" widget="many2many_binary"/>
                        <field name="bank_statement_id" widget="many2many_binary"/>
                        <field name="salary_slip_id" widget="many2many_binary"/>
                        <field name="photograph" widget="many2many_binary"/>
                    </group>

                    <!-- ===================== -->
                    <!-- EXPERIENCE -->
                    <!-- ===================== -->
                    <group string="Work Experience">

                        <field name="experience_ids"
                               context="{'default_applicant_id': id}"
                               mode="list,form"
                               nolabel="1">

                            <list string="Experience">
                                <field name="company_name"/>
                                <field name="years"/>
                            </list>

                            <form string="Experience Details">
                                <sheet>
                                    <group>
                                        <field name="applicant_id" invisible="1"/>
                                        <field name="company_name"/>
                                        <field name="years"/>
                                    </group>

                                    <group string="Documents" col="2">
                                        <field name="experience_certificate"
                                               filename="experience_certificate_filename"/>

                                        <field name="joining_letter"
                                               filename="joining_letter_filename"/>

                                        <field name="relieving_letter"
                                               filename="relieving_letter_filename"/>

                                        <field name="other_certificate"
                                               filename="other_certificate_filename"/>
                                    </group>
                                </sheet>
                            </form>

                        </field>
                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>