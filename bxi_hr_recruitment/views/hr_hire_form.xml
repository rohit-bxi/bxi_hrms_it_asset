<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Recruitment Stage -->
    <record id="stage_make_proposal" model="hr.recruitment.stage">
        <field name="name">Make Proposal</field>
        <field name="sequence">3</field>
        <field name="fold">False</field>
    </record>

    <!-- Applicant Form Inheritance -->
    <record id="view_hr_applicant_form_inherit_proposal" model="ir.ui.view">
        <field name="name">hr.applicant.form.proposal</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='categ_ids']" position="after">
                <field name="first_interview_remark"
                       invisible="stage_id != 3"
                       placeholder="Enter feedback for First Interview"/>
                <field name="second_interview_remark"
                       invisible="stage_id != 4"
                       placeholder="Enter feedback for Second Interview"/>/>
            </xpath>

<!--            <xpath expr="//header" position="inside">-->
<!--                <button name="action_send_selection_notification"-->
<!--                        type="object"-->
<!--                        string="Send Selection Notification"-->
<!--                        class="oe_highlight"-->
<!--                        invisible="not stage_id.hired_stage"/>-->
<!--            </xpath>-->

            <xpath expr="//notebook" position="inside">
                <page string="Proposal">

                    <!-- Personal Details -->
                    <group string="Personal Details">
                        <group>
                            <field name="partner_name" string="Full Name"/>
                            <field name="contact_number"/>
                            <field name="email_from" string="Email"/>
                        </group>
                        <group>
                            <field name="father_name"/>
                            <field name="mother_name"/>
                            <field name="aadhar_number"/>
                            <field name="pan_number"/>
                        </group>
                    </group>

                    <!-- Address -->
                    <group string="Full Address">
                        <field name="full_address"/>
                        <field name="joining_date"/>
                    </group>
                     <!-- Offer Letter Section -->
                    <group string="Offer Letter">
                        <field name="offer_letter_generated" invisible="1"/>

                        <button name="action_generate_offer_letter"
                                type="object"
                                string="Generate Offer Letter"
                                class="btn-primary"/>

                        <button name="action_view_offer_letter"
                                type="object"
                                string="View Offer Letter"
                                class="btn-secondary"
                                invisible="not offer_letter_generated"/>
                    </group>

                    <!-- Document Upload -->
                    <group string="Document Upload">
                        <field name="doc_10th"/>
                        <field name="doc_12th"/>
                        <field name="doc_graduation"/>
                        <field name="doc_master"/>
                    </group>

                    <!-- Other Documents -->
                    <group string="Other Documents">
                        <field name="form_16"/>
                        <field name="bank_statement"/>
                        <field name="salary_slip"/>
                        <field name="photograph" widget="image" class="oe_avatar"/>
                    </group>

                    <!-- Experience -->
                    <group string="Experience">
                        <field name="experience_ids"
                               context="{'default_applicant_id': id}"
                               mode="list,form"
                               nolabel="1">

                            <!-- List View -->
                            <list string="Experience">
                                <field name="company_name"/>
                                <field name="years"/>
                            </list>

                            <!-- Form View -->
                            <form string="Experience Details">
                                <sheet>
                                    <group>
                                        <field name="applicant_id" invisible="1"/>
                                        <field name="company_name"/>
                                        <field name="years"/>
                                    </group>
                                    <group string="Documents" col="2">
                                        <field name="experience_certificate"
                                               filename="experience_certificate_filename"/>
                                        <field name="joining_letter"
                                               filename="joining_letter_filename"/>
                                        <field name="relieving_letter"
                                               filename="relieving_letter_filename"/>
                                        <field name="other_certificate"
                                               filename="other_certificate_filename"/>
                                    </group>
                                </sheet>
                            </form>

                        </field>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

</odoo>

