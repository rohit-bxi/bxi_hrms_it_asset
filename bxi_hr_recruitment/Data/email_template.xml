<odoo>
    <data>

        <!-- 1️⃣ Qualification -->
        <record id="email_stage_qualification" model="mail.template">
            <field name="name">Qualification Stage</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="subject">Application Shortlisted</field>
            <field name="email_from">hrsupport@bxitech.com</field>

            <field name="body_html"><![CDATA[
                <p>Dear <b><t t-esc="object.partner_name"/></b>,</p>

                <p>
                    Congratulations! Your application for
                    <strong><t t-esc="object.job_id.name"/></strong>
                    has been shortlisted.
                </p>

                <p>
                    You are shortlisted for the <b>First Interview Round</b>.
                    Our team will contact you soon.
                </p>

                <p>Best Regards,<br/>HR Team</p>
            ]]></field>
        </record>


        <!-- 2️⃣ First Interview (Schedule) -->
        <record id="email_stage_first_interview" model="mail.template">
            <field name="name">First Interview Stage</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="subject">Interview Scheduled</field>
            <field name="email_from">hrsupport@bxitech.com</field>

            <field name="body_html"><![CDATA[
                <p>Dear <b><t t-esc="object.partner_name"/></b>,</p>

                <p>
                    Your <b>First Interview</b> has been scheduled.
                </p>

                <p>
                    📅 Date & Time: Will be shared shortly<br/>
                    🔗 Meeting Link: Will be provided soon
                </p>

                <p>
                    Please be available on time.
                </p>

                <p>Best Regards,<br/>HR Team</p>
            ]]></field>
        </record>


        <!-- 3️⃣ Second Interview -->
        <record id="email_stage_second_interview" model="mail.template">
            <field name="name">Second Interview Stage</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="subject">Second Interview Round</field>
            <field name="email_from">hrsupport@bxitech.com</field>

            <field name="body_html"><![CDATA[
                <p>Dear <b><t t-esc="object.partner_name"/></b>,</p>

                <p>
                    Congratulations! You have successfully cleared the <b>First Interview Round</b>.
                </p>

                <p>
                    You are now selected for the <b>Second Interview Round</b>.
                    We will share the meeting details shortly.
                </p>

                <p>Best Regards,<br/>HR Team</p>
            ]]></field>
        </record>


        <!-- 4️⃣ Final Interview -->
        <record id="email_stage_final_interview" model="mail.template">
            <field name="name">Final Interview Stage</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="subject">Final Interview Round</field>
            <field name="email_from">hrsupport@bxitech.com</field>

            <field name="body_html"><![CDATA[
                <p>Dear <b><t t-esc="object.partner_name"/></b>,</p>

                <p>
                    Great news! You have cleared the <b>Second Interview Round</b>.
                </p>

                <p>
                    You are now moving forward to the <b>Final Interview Round</b>.
                    Details will be shared soon.
                </p>

                <p>Best Regards,<br/>HR Team</p>
            ]]></field>
        </record>


        <!-- 5️⃣ Final Selection -->
        <record id="email_stage_contract_proposal" model="mail.template">
            <field name="name">Final Selection</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="subject">Congratulations - Final Selection</field>
            <field name="email_from">hrsupport@bxitech.com</field>

            <field name="body_html"><![CDATA[
                <p>Dear <b><t t-esc="object.partner_name"/></b>,</p>

                <p>
                    🎉 Congratulations! You have successfully cleared the <b>Final Interview Round</b>.
                </p>

                <p>
                    We are pleased to inform you that you have been <b>selected</b>.
                    Our HR team will contact you soon with further details.
                </p>

                <p>Best Regards,<br/>HR Team</p>
            ]]></field>
        </record>

        <!-- 6️⃣ Offer Letter (Contract Proposal Stage) -->
        <record id="email_stage_offer_letter" model="mail.template">
            <field name="name">Offer Letter Mail</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="subject">Official Job Offer</field>
            <field name="email_from">hrsupport@bxitech.com</field>

            <field name="body_html"><![CDATA[
        <p>Dear <b><t t-esc="object.partner_name"/></b>,</p>

        <p>
            🎉 Congratulations! You have successfully cleared all interview rounds for the position of
            <strong><t t-esc="object.job_id.name"/></strong>.
        </p>

        <p>
            We are pleased to share your <b>official job offer</b>.
        </p>

        <ul>
            <li>Job Role & Responsibilities</li>
            <li>Salary Package</li>
            <li>Company Policies</li>
            <li>Joining Details</li>
        </ul>

        <p>Please review and confirm your acceptance.</p>

        <p>Best Regards,<br/>HR Team</p>
    ]]></field>
        </record>

    </data>
</odoo>
