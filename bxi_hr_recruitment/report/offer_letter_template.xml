<odoo>
    <template id="report_offer_letter">

        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <t t-set="company" t-value="o.company_id or res_company"/>

                <t t-call="web.external_layout">

                    <!-- ===================== STYLES ===================== -->
                    <style>
                        .offer-body {
                            font-family: "Times New Roman", Times, serif;
                            font-size: 12pt;
                            line-height: 1.8;
                            text-align: justify;
                            color: #000000;
                        }
                        .offer-title {
                            text-align: center;
                            font-size: 24pt;
                            font-weight: bold;
                            color: #1f4e79;
                            letter-spacing: 1px;
                            margin-bottom: 10px;
                        }
                        .offer-meta {
                            font-size: 12pt;
                            margin-bottom: 5px;
                        }
                        .doc-id {
                            text-align: right;
                            font-size: 11pt;
                            margin-bottom: 10px;
                        }
                        .company-highlight {
                            font-weight: bold;
                            color: #1f4e79;
                        }
                        .signature {
                            margin-top: 40px;
                        }
                        .legal-text {
                            font-size: 10pt;
                            color: #444444;
                        }
                        .page {
                            page-break-after: always;
                        }
                        .page:last-child {
                            page-break-after: auto;
                        }
                    </style>

                    <!-- ===================== PAGE 1 ===================== -->
                    <div class="page offer-body">

                        <div class="offer-title">OFFER LETTER</div>

                        <!-- Offer Date -->
                        <p class="offer-meta">
                            <strong>Offer Release Date:</strong>
                            <t t-esc="o.create_date and o.create_date.strftime('%d-%m-%Y')"/>
                        </p>

                        <!-- Candidate -->
                        <p class="offer-meta">
                            <t t-esc="o.partner_name"/><br/>
                            <t t-esc="o.partner_id.city if o.partner_id else ''"/>
                        </p>

                        <!-- Doc ID -->
                        <p class="doc-id">
                            <strong>Document ID - </strong>
                            <t t-esc="o.id"/>
                        </p>

                        <!-- Greeting -->
                        <p>
                            Dear <strong><t t-esc="o.partner_name"/></strong>,
                        </p>

                        <!-- Para 1 -->
                        <p>
                            Congratulations! With reference to your application and interview, we are pleased to inform you that you have been selected for employment in
                            <span class="company-highlight">
                                <t t-esc="company.name"/>
                            </span>
                            as <strong><t t-esc="o.job_id.name"/></strong>.
                        </p>

                        <!-- Para 2 -->
                        <p>
                            We encourage you to continuously enhance your skills, contribute meaningfully, and maintain a healthy work-life balance for long-term success.
                        </p>

                        <!-- Para 3 -->
                        <p>
                            You are requested to join us on or before
                            <strong>
                                <t t-esc="o.joining_date and o.joining_date.strftime('%d-%m-%Y')"/>
                            </strong>.
                        </p>

                        <!-- Para 4 -->
                        <p>
                            You will be on probation for a period of 6 months. Your compensation structure is detailed in Annexure I, and general terms and conditions are outlined in Annexure III.
                        </p>

                    </div>

                    <!-- ===================== PAGE 2 ===================== -->
                    <div class="page offer-body">

                        <p>
                            You are required to submit all necessary documents as per Annexure IV before your joining date to complete onboarding formalities.
                        </p>

                        <p>
                            This offer is subject to successful background verification. You are required to submit relevant documents within two business days.
                        </p>

                        <p>
                            Any change in joining date must be communicated at least one week in advance.
                        </p>

                        <p>
                            We look forward to a mutually beneficial and successful association. Welcome aboard!
                        </p>

                        <!-- Signature -->
                        <div class="signature">
                            <p>
                                <strong>For <t t-esc="company.name"/></strong>
                            </p>
                        </div>

                        <!-- Legal -->
                        <p class="legal-text">
                            This is a system-generated document and is legally valid without a physical signature.
                        </p>

                    </div>

                </t>
            </t>
        </t>

    </template>
</odoo>