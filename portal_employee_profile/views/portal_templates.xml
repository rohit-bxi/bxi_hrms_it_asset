<odoo>
    <template id="portal_employee_profile" name="Employee Profile">
        <t t-call="portal.portal_layout">
            <div class="container portal-employee mt-4 mb-5">

                <t t-if="employee">
                    <form action="/my/employee-profile/update" method="post"
                          enctype="multipart/form-data"
                          class="card shadow-sm">

                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>

                        <!-- HEADER -->
                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0">My Employee Profile</h4>
                        </div>

                        <div class="card-body">

<!-- ========================================================= -->
<!-- PRIVATE CONTACT -->
<!-- ========================================================= -->
<h5 class="section-title">Private Contact</h5>
<div class="row g-3">
    <div class="col-md-6">
        <label>Employee Name</label>
        <input name="name" class="form-control"
               t-att-value="employee.name"
               required="1"/>
    </div>

    <div class="col-md-6">
        <label>Employee Code</label>
        <input name="employee_code" class="form-control"
               t-att-value="employee.employee_code" readonly="1"/>
    </div>

    <div class="col-md-6">
        <label>Personal Email</label>
        <input name="private_email" class="form-control"
               t-att-value="employee.private_email"
               required="1"
               />
    </div>

    <div class="col-md-6">
        <label>Work Email</label>
        <input name="work_email" class="form-control"
               t-att-value="employee.work_email"
               required="1"
               />
    </div>

    <div class="col-md-6">
        <label>Phone</label>
        <input name="private_phone" class="form-control"
               t-att-value="employee.private_phone"
               required="1"
               />
    </div>

    <div class="col-md-6">
        <label>Medical Insurance No</label>
        <input name="medical_insurance_no" class="form-control"
               t-att-value="employee.medical_insurance_no"
               />
    </div>

    <div class="col-md-6">
        <label>Bank Accounts</label>
        <input class="form-control"
               t-att-value="', '.join(employee.bank_account_ids.mapped('acc_number'))"
               />
    </div>
    <div class="col-md-6">
        <label>Aadhar Number</label>
        <input name="aadhar_card" class="form-control"
               t-att-value="employee.aadhar_card"
               required="1"
               />
    </div>
</div>

<!-- ========================================================= -->
<!-- PERSONAL INFORMATION -->
<!-- ========================================================= -->
<h5 class="section-title mt-4">Personal Information</h5>
<div class="row g-3">

    <div class="col-md-6">
        <label>Birthday</label>
        <input type="date" name="birthday" class="form-control"
               t-att-value="employee.birthday"/>
    </div>

    <div class="col-md-6">
        <label>Language</label>
        <input class="form-control"
               t-att-value="employee.lang"
               />
    </div>
</div>

<!-- ========================================================= -->
<!-- EMERGENCY CONTACT -->
<!-- ========================================================= -->
<h5 class="section-title mt-4">Emergency Contact</h5>
<div class="row g-3">
    <div class="col-md-4">
        <label>Contact Name</label>
        <input name="emergency_contact" class="form-control"
               t-att-value="employee.emergency_contact"
               required="1"/>

    </div>

    <div class="col-md-4">
        <label>Relationship</label>
        <input name="l10n_in_relationship" class="form-control"
               t-att-value="employee.l10n_in_relationship"/>
    </div>

    <div class="col-md-4">
        <label>Phone</label>
        <input name="emergency_phone" class="form-control"
               t-att-value="employee.emergency_phone"
               required="1"
               />
    </div>
</div>

<!-- ========================================================= -->
<!-- CITIZENSHIP -->
<!-- ========================================================= -->
<h5 class="section-title mt-4">Citizenship</h5>
<div class="row g-3">
    <div class="col-md-6">
        <label>Nationality</label>
        <input class="form-control"
               t-att-value="employee.country_id.name"
               required="1"
               />
    </div>

    <div class="col-md-3">
        <label>Non-Resident</label><br/>
        <input type="checkbox" name="is_non_resident"
               t-att-checked="employee.is_non_resident"
               />
    </div>

    <div class="col-md-3">
        <label>Passport No</label>
        <input name="passport_id" class="form-control"
               t-att-value="employee.passport_id"/>
    </div>
</div>

<!-- ========================================================= -->
<!-- FAMILY -->
<!-- ========================================================= -->
<h5 class="section-title mt-4">Family</h5>
<div class="row g-3">
    <div class="col-md-4">
        <label>Marital Status</label>
        <select name="marital" class="form-control">
            <t t-foreach="employee.fields_get(['marital'])['marital']['selection']" t-as="opt">
                <option t-att-value="opt[0]"
                        t-att-selected="opt[0] == employee.marital">
                    <t t-esc="opt[1]"/>
                </option>
            </t>
        </select>
    </div>

    <div class="col-md-4">
        <label>Dependent Children</label>
        <input type="number" name="children" class="form-control"
               t-att-value="employee.children"/>
    </div>

    <div class="col-md-4">
        <label>Disabled</label><br/>
        <input type="checkbox" name="disabled"
               t-att-checked="employee.disabled"/>
    </div>
</div>

<!-- ========================================================= -->
<!-- LOCATION -->
<!-- ========================================================= -->
<h5 class="section-title mt-4">Private Address</h5>
<div class="row g-3">
    <div class="col-md-3">
        <label>Street</label>
        <input name="private_street" class="form-control"
               t-att-value="employee.private_street"/>
    </div>

    <div class="col-md-3">
        <label>Street 2</label>
        <input name="private_street2" class="form-control"
               t-att-value="employee.private_street2"/>
    </div>

    <div class="col-md-3">
        <label>City</label>
        <input name="city" class="form-control"
               t-att-value="employee.private_city"
               required="1"/>

    </div>

    <div class="col-md-3">
        <label>Zip</label>
        <input name="zip" class="form-control"
               t-att-value="employee.private_zip"/>
    </div>
</div>

<!-- Personal Information (Bottom Section) -->
<div class="employee-personal-info mt-4">
    <h4>Personal Information</h4>
    <div class="row">
        <!-- UAN -->
        <div class="col-md-6 mb-3">
            <label>UAN</label>
            <input name="l10n_in_uan" type="text" class="form-control" t-att-value="employee.l10n_in_uan"
                required="1"
                />
        </div>

        <!-- ESIC Number -->
        <div class="col-md-6 mb-3">
            <label>ESIC Number</label>
            <input name="l10n_in_esic_number" type="text" class="form-control" t-att-value="employee.l10n_in_esic_number"
                />

        </div>

        <!-- PAN -->
        <div class="col-md-6 mb-3">
            <label>PAN</label>
            <input name="l10n_in_pan" type="text" class="form-control" t-att-value="employee.l10n_in_pan"
                required="1"
                />
        </div>
    </div>
</div>


<!-- ========================================================= -->
<!-- ACTION -->
<!-- ========================================================= -->
<div class="mt-4 text-end">
    <button type="submit" class="btn btn-success px-4">
        Update Profile
    </button>
</div>

                        </div>
                    </form>
                </t>

                <t t-if="not employee">
                    <div class="alert alert-warning">
                        No employee record linked to your account.
                        Please contact HR.
                    </div>
                </t>
                <!-- ====== SUCCESS ALERT SCRIPT ====== -->
                <t t-if="request.params.get('profile_updated')">
                    <script type="text/javascript">
                        alert("Profile successfully updated!");
                        window.location.href = '/my/home';
                    </script>
                </t>

            </div>
        </t>
    </template>
</odoo>
