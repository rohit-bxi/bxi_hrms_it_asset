<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_bulk_expense_release" model="ir.actions.server">
    <field name="name">Release Expense</field>
    <field name="model_id" ref="hr_expense.model_hr_expense"/>
    <field name="binding_model_id" ref="hr_expense.model_hr_expense"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
        action = records.action_expense_release()
    </field>
</record>

    <record id="view_hr_expense_icici_form" model="ir.ui.view">
        <field name="name">hr.expense.form.icici</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_expense_release"
                    string="Release Expense"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'posted'"/>
                <button
                    name="action_open_transaction_status_wizard"
                    string="Check Payment Status"
                    type="object"
                    class="btn-primary"
                    invisible="icici_payment_status != 'processing'"/>
            </xpath>
            <xpath expr="//group[2]" position="after">
                <group string="ICICI Payment">
                    <field name="icici_payment_status" readonly="1"/>
                    <field name="icici_file_seq_num" readonly="1"/>
                    <field name="icici_response" readonly="1" widget="text"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
