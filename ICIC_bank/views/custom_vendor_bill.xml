<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_bulk_expense_release" model="ir.actions.server">
    <field name="name">Release Vendor Payment</field>
    <field name="model_id" ref="account.model_account_payment"/>
    <field name="binding_model_id" ref="account.model_account_payment"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
        action = records.action_vendor_bill_release()
    </field>
</record>

    <record id="view_account_payment_icici_form" model="ir.ui.view">
        <field name="name">account.payment.form.icici</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
             <xpath expr='//button[@name="action_cancel"]' position="after">
                <button
                    name="action_vendor_bill_release"
                    string="Release Vendor Payment"
                    type="object"
                    class="btn-primary"
                    invisible="state != 'in_process'"/>
                <button
                    name="action_open_transaction_status_wizard"
                    string="Check Payment Status"
                    type="object"
                    class="btn-primary"
                    invisible="icici_payment_status != 'processing'"/>
            </xpath>
             <xpath expr="//group[2]" position="after">
                <group string="ICICI Payment">
                    <field name="icici_payment_status" readonly="1"/>
                    <field name="icici_reference" readonly="1"/>
                    <field name="icici_file_seq_num" readonly="1"/>
                    <field name="icici_utr" readonly="1"/>
                    <field name="icici_response" readonly="1" widget="text"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
