<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payslip_form_icici" model="ir.ui.view">

        <field name="name">hr.payslip.form.icici</field>

        <field name="model">hr.payslip</field>

        <field name="inherit_id"
               ref="hr_payroll.view_hr_payslip_form"/>

        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">

                <button
                    name="action_release_salary"
                    string="Release Salary"
                    type="object"
                    class="btn btn-primary"
                    invisible="state != 'done'"
                />

            </xpath>

            <xpath expr="//sheet" position="inside">

                <group string="ICICI Payment Details">

                    <field name="icici_payment_status"
                           readonly="1"/>

                    <field name="icici_reference"
                           readonly="1"/>

                    <field name="icici_file_seq_num"
                           readonly="1"/>

                    <field name="icici_response"
                           readonly="1"
                           widget="text"/>

                </group>

            </xpath>

        </field>

    </record>

</odoo>