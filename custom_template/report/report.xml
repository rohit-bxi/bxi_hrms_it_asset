<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="bxi_custom_layout">

        <t t-call="web.html_container">

            <!-- COMPANY -->
            <t t-set="company"
               t-value="o.template_company_id or res_company"/>

            <!-- COLOR -->
            <t t-set="header_bg"
               t-value="'#0b2a6f' if company.name == 'BXI TECHNOLOGY LLP' else '#5b0f00'"/>

            <div class="page"
                 t-attf-style="
                    position:relative;
                    min-height:1122px;
                    font-family:Arial, sans-serif;
                    font-size:14px;
                    padding-bottom:110px;
                 ">

                <!-- HEADER -->
                <div t-attf-style="
                    width:100%;
                    height:90px;
                    background:#{header_bg};
                    padding:0 30px;
                    box-sizing:border-box;
                ">

                    <table style="
                        width:100%;
                        height:90px;
                        border-collapse:collapse;
                    ">
                        <tr>

                            <!-- LEFT LOGO -->
                            <td style="
                                width:20%;
                                vertical-align:middle;
                                text-align:left;
                            ">
                                <t t-if="company.logo_web">
                                    <img t-att-src="image_data_uri(company.logo_web)"
                                         style="
                                            height:55px;
                                            width:auto;
                                         "/>
                                </t>
                            </td>

                            <!-- CENTER COMPANY NAME -->
                            <td style="
                                width:60%;
                                vertical-align:middle;
                                text-align:center;
                                color:#ffffff;
                                font-size:22px;
                                font-weight:bold;
                                text-transform:uppercase;
                                letter-spacing:1px;
                            ">
                                <t t-esc="company.name"/>
                            </td>

                            <!-- RIGHT EMPTY -->
                            <td style="width:20%;"></td>

                        </tr>
                    </table>
                </div>

                <!-- BODY -->
                <div style="
                    padding:30px 20px 20px 20px;
                ">
                    <t t-out="0"/>
                </div>

                <!-- FOOTER -->
                <div t-attf-style="
                    position:absolute;
                    bottom:0;
                    left:0;
                    width:100%;
                    height:90px;
                    background:#{header_bg};
                    color:#ffffff;
                    font-size:8px;
                ">

                    <table style="
                        width:100%;
                        height:90px;
                        border-collapse:collapse;
                        color:#ffffff;
                    ">

                        <tr>

                            <!-- LEFT -->
                            <td style="
                                width:45%;
                                padding:10px 15px;
                                vertical-align:middle;
                                line-height:13px;
                                color:#ffffff;
                            ">
                                <strong>
                                    <t t-esc="company.name"/>
                                </strong>
                                <br/>

                                <t t-esc="company.street or ''"/>

                                <t t-if="company.street2">
                                    <span>, </span>
                                    <t t-esc="company.street2"/>
                                </t>

                                <br/>

                                <t t-esc="company.city or ''"/>

                                <t t-if="company.state_id">
                                    <span>, </span>
                                    <t t-esc="company.state_id.name"/>
                                </t>

                                <t t-if="company.zip">
                                    <span> - </span>
                                    <t t-esc="company.zip"/>
                                </t>

                                <br/>

                                <t t-esc="company.country_id.name or ''"/>
                            </td>

                            <!-- CENTER -->
                            <td style="
                                width:35%;
                                vertical-align:middle;
                                text-align:right;
                                padding:10px;
                                line-height:14px;
                                color:#ffffff;
                            ">

                                <div>
                                    CIN :
                                    <t t-esc="company.company_registry or 'N/A'"/>
                                </div>

                                <div>
                                    Email :
                                    <t t-esc="company.email or ''"/>
                                </div>

                                <div>
                                    Phone :
                                    <t t-esc="company.phone or ''"/>
                                </div>

                            </td>

                            <!-- RIGHT LOGO -->
                            <td style="
                                width:20%;
                                vertical-align:middle;
                                text-align:center;
                                padding:10px;
                            ">
                                <t t-if="company.logo_web">
                                    <img t-att-src="image_data_uri(company.logo_web)"
                                         style="
                                            max-height:35px;
                                            width:auto;
                                         "/>
                                </t>
                            </td>

                        </tr>

                    </table>

                </div>

            </div>

        </t>

    </template>
</odoo>