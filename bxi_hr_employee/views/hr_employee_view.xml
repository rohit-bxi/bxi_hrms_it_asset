<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_form_inherit_employee_code" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.employee.code</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="employee_code" />
                <field name="pa_name" />
                <field name="psa" />
                <field name="role_band" />
                <field name="disp" />
                <field name="aadhar_card" />
                <field name="probation_period" />
                <field name="trainee_category" />
                <field name="onsite_offshore" />
                <field name="emp_category" />
                <field name="emp_skill_category" />

            </xpath>
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <label for="nps_contribution" />
                <div class="o_row">
                    <field name="nps_contribution" class="oe_inline" />
                    <span class="text-muted">/ month</span>
                </div>
                <button name="action_calculate_l10n_in_tds_new_regime"
                    type="object"
                    string="Calculate TDS"
                    class="btn btn-primary"
                    style="margin-left:10px;" />
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="before">
                <field name="manager_emp_code" />
            </xpath>
            <xpath expr="//field[@name='bank_account_ids']" position="after">
                <field name="medical_insurance_no" />
                <field name="bank_name" />
                <field name="bank_ifsc" />
                <field name="bank_account_number" />
                <field name="bank_document" />
            </xpath>
        </field>
    </record>

    <record id="view_employee_form_inherit_contract_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.contract.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">

            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Contract Payroll" invisible="employee_type != 'contractor'">
                    <group string="Contract Payment Details">
                        <group>
                            <field name="template_company_id" />
                            <field name="month_year" />
                            <field name="meeting_qty" />
                            <field name="meeting_rate" />
                            <field name="script_qty" />
                            <field name="script_rate" />
                            <field name="video_qty" />
                            <field name="video_rate" />
                            <field name="total_amount" readonly="1" />
                        </group>
                    </group>
                    <button name="action_download_contract_payslip"
                        string="Download Contract Payslip"
                        type="object"
                        class="btn-primary" />
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_employee_inherit_document" model="ir.ui.view">
        <field name="name">hr.employee.inherit.document</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Employee Documents">
                    <group>
                        <button name="action_send_data_privacy_doc"
                            string="Send Employee Addtional Documents"
                            type="object"
                            class="btn-primary" />
                        <button name="action_send_employee_doc"
                            string="Send Employee Document"
                            type="object"
                            class="btn-primary" />
                    </group>
                    <group name="name" string="Data Privacy Document">
                        <field name="data_privacy_doc" widget="many2many_binary" />
                    </group>
                    <group string="Employee Documents">
                        <group>
                            <field name="adhar_card_front" widget="many2many_binary" />
                            <field name="adhar_card_back" widget="many2many_binary" />
                            <field name="pan_number_proof" widget="many2many_binary" />
                            <field name="doc_10th_id" widget="many2many_binary" />
                            <field name="doc_12th_id" widget="many2many_binary" />
                        </group>
                        <group>
                            <field name="doc_graduation_id" widget="many2many_binary" />
                            <field name="doc_master_id" widget="many2many_binary" />
                            <field name="any_certificate" widget="many2many_binary" />
                            <field name="photograph" widget="many2many_binary" />
                        </group>
                        <group>
                            <field name="experience_ids"
                               context="{'default_employee_id': id}"
                               mode="list,form"
                               nolabel="1">

                            <list string="Experience">
                                <field name="company_name"/>
                                <field name="years"/>
                            </list>

                            <form string="Experience Details">
                                <sheet>
                                    <group>
                                        <field name="company_name"/>
                                        <field name="years"/>
                                    </group>

                                    <group string="Documents" col="2">
                                        <field name="joining_letter"
                                               filename="joining_letter_filename" widget="many2many_binary"/>
                                        <field name="experience_certificate"
                                               filename="experience_certificate_filename" widget="many2many_binary"/>

                                        <field name="relieving_letter"
                                               filename="relieving_letter_filename" widget="many2many_binary"/>

                                        <field name="other_certificate"
                                               filename="apprsail_letter_filename" widget="many2many_binary"/>
                                        <field name="bank_statement_id" widget="many2many_binary"/>
                                        <field name="salary_slip_id" widget="many2many_binary"/>
                                    </group>
                                </sheet>
                            </form>

                        </field>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>