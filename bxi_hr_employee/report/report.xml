<odoo>

    <record id="action_report_appraisal_letter"
            model="ir.actions.report">

        <field name="name">Appraisal Letter</field>

        <field name="model">hr.employee.appraisal</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">bxi_hr_employee.report_appraisal_letter_template</field>

        <field name="report_file">bxi_hr_employee.report_appraisal_letter_template</field>

        <field name="print_report_name">
            'Appraisal Letter - %s' % (object.employee_id.name)
        </field>

    </record>

</odoo>