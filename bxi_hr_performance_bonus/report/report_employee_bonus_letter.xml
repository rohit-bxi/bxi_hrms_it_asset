<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_employee_bonus_letter">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <!-- COMPANY -->
                <t t-set="company"
                   t-value="o.template_company_id"/>

                <!-- ================= LAYOUT SWITCH (5 COMPANIES) ================= -->

                <t t-if="o.template_company_id and o.template_company_id.id == 1">

                    <t t-call="custom_template.bxi_custom_layout">
                        <t t-call="bxi_hr_performance_bonus._bonus_letter_content"/>
                    </t>

                </t>

                <t t-elif="o.template_company_id and o.template_company_id.id == 2">

                    <t t-call="custom_template.bxi_n01_layout">
                        <t t-call="bxi_hr_performance_bonus._bonus_letter_content"/>
                    </t>

                </t>

                <t t-elif="o.template_company_id and o.template_company_id.id == 3">

                    <t t-call="custom_template.bxi_custom_layout">
                        <t t-call="bxi_hr_performance_bonus._bonus_letter_content"/>
                    </t>

                </t>

                <t t-elif="o.template_company_id and o.template_company_id.id == 4">

                    <t t-call="custom_template.bxi_n01_layout">
                        <t t-call="bxi_hr_performance_bonus._bonus_letter_content"/>
                    </t>

                </t>

                <t t-elif="o.template_company_id and o.template_company_id.id == 5">

                    <t t-call="custom_template.bxi_custom_layout">
                        <t t-call="bxi_hr_performance_bonus._bonus_letter_content"/>
                    </t>

                </t>

                <!-- DEFAULT -->
                <t t-else="">

                    <t t-call="custom_template.bxi_custom_layout">
                        <t t-call="bxi_hr_performance_bonus._bonus_letter_content"/>
                    </t>

                </t>

            </t>

        </t>
    </template>


    <!-- ================= CONTENT BLOCK (USED FOR ALL COMPANIES) ================= -->
    <template id="_bonus_letter_content">

        <div class="page"
             style="font-family: Arial, sans-serif;
                    font-size: 14px;
                    line-height: 1.8;
                    padding: 30px;">

            <!-- TITLE -->
            <div style="text-align:center; margin-bottom:40px;">
                <h2 style="margin:0; text-transform:uppercase;">
                    Bonus Letter
                </h2>
            </div>

            <!-- EMPLOYEE DETAILS -->
            <p>
                <strong>Employee Name :</strong>
                <span t-field="o.employee_id.name"/>
            </p>

            <p>
                <strong>Emp. Code :</strong>
                <span t-field="o.employee_code"/>
            </p>

            <!-- BODY -->
            <p>
                Dear <strong><span t-field="o.employee_id.name"/></strong>,
            </p>

            <p>
                We are pleased to inform you that you have been awarded a
                <strong>Bonus Payout</strong> for your contribution and performance during the
                review period.
            </p>

            <p>
                Your payout details are as follows:
            </p>

            <p>
                <strong>Bonus Payout Amount :</strong>
                INR <span t-field="o.bonus_amount"/>
            </p>

            <p>
                <strong>Payout Month :</strong>
                <span t-field="o.payout_month"/>
            </p>

            <p>
                This payout reflects your efforts, commitment, and contribution towards the success
                of the organization during the review period.
            </p>

            <p><strong>Please note:</strong></p>

            <ul style="margin-left: 20px;">
                <li>The payout is subject to applicable taxes and statutory deductions as per company policy.</li>
                <li>This payout is discretionary in nature and based on performance, business outcomes, and management approval.</li>
                <li>The payout will be processed in the salary cycle of payout month.</li>
            </ul>

            <p>
                We appreciate your dedication, hard work, and continued contribution.
                We look forward to your ongoing support in achieving greater milestones together.
            </p>

            <p>
                Congratulations and wishing you continued success ahead.
            </p>

            <!-- SIGNATURE -->
            <div style="margin-top: 70px;">
                <p>Sincerely,</p>

                <br/><br/>

                <table style="width: 100%;">
                    <tr>
                        <td style="width: 50%;">
                            <strong>Pallavi Paliwal</strong>
                            <br/>
                            Partner &amp; MD
                        </td>

                        <td style="width: 50%; text-align: right;">
                            <strong>Nazia Khan</strong>
                            <br/>
                            HR Head
                        </td>
                    </tr>
                </table>
            </div>

        </div>

    </template>

</odoo>