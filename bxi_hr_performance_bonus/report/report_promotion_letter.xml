<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= REPORT ACTION ================= -->
    <record id="action_report_promotion_letter" model="ir.actions.report">
        <field name="name">Promotion Letter</field>
        <field name="model">hr.employee.appraisal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bxi_hr_performance_bonus.report_promotion_letter_template</field>
        <field name="report_file">bxi_hr_performance_bonus.report_promotion_letter_template</field>
        <field name="print_report_name">'Promotion Letter - %s' % (object.employee_id.name)</field>
        <field name="paperformat_id" ref="paperformat_bonus_letter_a4" />
    </record>


    <!-- ================= MAIN TEMPLATE ================= -->
    <template id="report_promotion_letter_template">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <!-- COMPANY -->
                <t t-set="company" t-value="o.template_company_id" />

                <!-- ================= LAYOUT SWITCH (5 COMPANIES) ================= -->

                <t t-if="o.template_company_id and o.template_company_id.id == 1">

                    <t t-call="custom_template.bxi_custom_layout">
                        <t t-call="bxi_hr_performance_bonus._promotion_letter_content" />
                    </t>

                </t>

                <t t-elif="o.template_company_id and o.template_company_id.id == 2">

                    <t t-call="custom_template.bxi_n01_layout">
                        <t t-call="bxi_hr_performance_bonus._promotion_letter_content" />
                    </t>

                </t>

                <t t-elif="o.template_company_id and o.template_company_id.id == 3">

                    <t t-call="custom_template.bxi_custom_layout">
                        <t t-call="bxi_hr_performance_bonus._promotion_letter_content" />
                    </t>

                </t>

                <t t-elif="o.template_company_id and o.template_company_id.id == 4">

                    <t t-call="custom_template.bxi_n01_layout">
                        <t t-call="bxi_hr_performance_bonus._promotion_letter_content" />
                    </t>

                </t>

                <t t-elif="o.template_company_id and o.template_company_id.id == 5">

                    <t t-call="custom_template.bxi_custom_layout">
                        <t t-call="bxi_hr_performance_bonus._promotion_letter_content" />
                    </t>

                </t>

                <!-- DEFAULT -->
                <t t-else="">

                    <t t-call="custom_template.bxi_custom_layout">
                        <t t-call="bxi_hr_performance_bonus._promotion_letter_content" />
                    </t>

                </t>

            </t>

        </t>
    </template>


    <!-- ================= CONTENT BLOCK ================= -->
    <template id="_promotion_letter_content">

        <div class="page"
            style="padding:40px;
                    font-size:14px;
                    font-family:Arial, sans-serif;">

            <!-- TITLE -->
            <div style="text-align:center;">
                <h2>Promotion Letter</h2>
            </div>

            <br />

            <!-- DETAILS -->
            <table style="width:100%; border-collapse:collapse;">
                <tr>
                    <td>
                        <strong>Release Date:</strong>
                        <span t-field="o.release_date" />
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong>Employee Name:</strong>
                        <span t-field="o.employee_id.name" />
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong>Effective Date:</strong>
                        <span t-field="o.effective_date" />
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong>Emp. Code:</strong>
                        <span t-field="o.employee_code" />
                    </td>
                </tr>
            </table>

            <br />
            <br />

            <!-- BODY -->
            <p> Dear <strong>
                    <span t-field="o.employee_id.name" />
                </strong>, </p>

            <p>
                <strong>Congratulations!</strong>
            </p>

            <p style="text-align:justify;"> We are pleased to inform you that based on your
                performance, contribution, and continued commitment towards organizational goals,
                you are being promoted to the position of 
                <strong>
                    <t t-if="o.promoted_job_id">
                        <span t-field="o.promoted_job_id.name" />
                    </t>
                    <t t-else="">
                        <span t-field="o.promotion_job_id.name" />
                    </t>
                </strong>
                with effect from <strong>
                    <t t-if="o.effective_date">
                        <span t-field="o.effective_date" />
                    </t>
                    <t t-else="">
                        <span t-field="o.effective_date" />
                    </t>
                </strong>
            </p>

            <p>
                Your dedication, professionalism, and efforts have been valuable to the
                organization, and we are confident that you will continue to contribute with the
                same level of sincerity and ownership in your new role and responsibilities.

                Please note that all other terms and conditions of your employment remain unchanged
                unless otherwise communicated separately.
            </p>

            <p>
                We look forward to your continued contribution and wish you success in your enhanced
                role at <strong>
                    <t t-if="o.template_company_id.name">
                        <span t-field="o.template_company_id.name" />
                    </t>
                    <t t-else="">
                        <span t-field="o.template_company_id.name" />
                    </t>
                </strong>.
                Congratulations once again and best wishes for your continued growth with the
                organization.
            </p>

            <br />
            <br />

            <!-- SIGNATURE -->
            <div style="margin-top:70px;">
                <p>Sincerely,</p>

                <br />
                <br />

                <table style="width:100%;">
                    <tr>
                        <td style="width:50%;">
                            <strong>Pallavi Paliwal</strong><br /> Partner &amp; MD </td>

                        <td style="width:50%; text-align:right;">
                            <strong>Nazia Khan</strong><br /> HR Head </td>
                    </tr>
                </table>
            </div>

        </div>

    </template>

</odoo>