<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Paper Format -->
        <record id="paperformat_bonus_letter_a4" model="report.paperformat">
            <field name="name">Employee Bonus Letter A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">1</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_spacing">10</field>
        </record>

        <!-- Report Action -->
        <record id="action_report_employee_bonus_letter" model="ir.actions.report">
            <field name="name">Employee Bonus Letter</field>
            <field name="model">hr.employee.appraisal</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">bxi_hr_performance_bonus.report_employee_bonus_letter</field>
            <field name="report_file">bxi_hr_performance_bonus.report_employee_bonus_letter</field>
            <field name="print_report_name">'Bonus Letter - %s' % (object.employee_id.name or '')</field>
            <field name="paperformat_id" ref="paperformat_bonus_letter_a4"/>
        </record>

    </data>
</odoo>